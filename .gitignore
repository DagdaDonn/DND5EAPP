__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller build output -- regenerated by build_exe.sh/.bat, not
# source. Previously got committed by accident (90MB+ of binaries),
# which is most of why this repo's .git directory ballooned.
build/
dist/

# Android build cache (Qt + Python compiled for ARM64, several GB) --
# deleting this invalidates the python-for-android cache and forces a
# full 30-45 minute rebuild. Lives at deployment/ on machines actually
# building the APK; never commit it.
deployment/.buildozer/
deployment/jar/
deployment/recipes/*

# Exception: hand-patched python3 recipe that disables broken 3.14
# patches in p4a 2026.05.09. This is not regenerable from the wheels;
# losing it forces us to re-disable 6 patches by hand.
!deployment/recipes/python3/
!deployment/recipes/python3/__init__.py

# Exception: p4a.hook file that patches PythonActivity.java and
# copies Qt .so / libc++_shared.so into the APK. Hand-written, not
# regenerable from wheels. Reference from buildozer.spec via p4a.hook.
!deployment/recipes/p4a_hook.py

# Android build artifacts / tooling state
*.apk
*.apk.idsig
*.aab
*.ap_
.gradle/

# Stray backup files various build scripts drop next to what they patch
# (e.g. an icon-stripping step's *.pre-strip.bak). Same class of issue
# as buildozer.spec.bak.* below -- transient, not source.
*.pre-strip.bak

# dnd_app/ui_android/buildozer.spec is hand-edited and IS committed
# (see installer/android/build_apk.sh/.bat) -- only a stray copy at the
# repo root (which pyside6-android-deploy/buildozer can drop there) is
# ignored, since that one really is transient/regeneratable.
/buildozer.spec

# Downloaded PySide6/Shiboken Android wheels -- large binaries,
# regenerated from https://download.qt.io/official_releases/QtForPython/
packaging/android/wheels/*.whl

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
