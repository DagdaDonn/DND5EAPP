__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller build output -- regenerated by build_exe.sh/.bat, not
# source. Previously got committed by accident (90MB+ of binaries),
# which is most of why this repo's .git directory ballooned.
build/
dist/

# Android build cache (Qt + Python compiled for ARM64, several GB) --
# deleting this invalidates the python-for-android cache and forces a
# full 30-45 minute rebuild. Lives at deployment/ on machines actually
# building the APK; never commit it.
deployment/.buildozer/
deployment/jar/
deployment/recipes/

# Android build artifacts / tooling state
*.apk
*.aab
*.ap_
.gradle/

# Downloaded PySide6/Shiboken Android wheels -- large binaries,
# regenerated from https://download.qt.io/official_releases/QtForPython/
packaging/android/wheels/*.whl

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
